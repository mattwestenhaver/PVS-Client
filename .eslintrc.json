{
    "env": {
        "browser": true,
        "es2021": true,
        "jest": true
    },
    "rules": {
        "react/react-in-jsx-scope": "off",
        "no-unused-vars": [2, { "vars": "all", "args": "after-used" }],
        "no-console": "warn",
        "no-var": 2,
        "prefer-const": 2,
        "no-else-return": 1
    },
    "extends": ["eslint:recommended", "plugin:react/recommended", "plugin:prettier/recommended"],
    "parserOptions": {
        "sourceType": "module",
        "ecmaFeatures": {
            "impliedStrict": true,
            "jsx": true
        }
    }
}
